# ==============================================================================
# VIỆT NAM ĐA TẦNG — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Next.js Base Configuration
PORT=3000
NODE_ENV=production

# Supabase Realtime & PostgreSQL Configuration (Optional for Cloud Deploy)
# When omitted, the app automatically runs on the high-performance local server-authoritative in-memory engine!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-private-key

# Game Server Configuration
GAME_ROOM_TIMEOUT_HOURS=6
GAME_DEFAULT_QUESTION_SECONDS=20

